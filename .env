# ==============================================================================
# SpaceTeknopoliDataScience (st_ds) — Opsiyonel Çalışma Zamanı Yapılandırması
# ==============================================================================
# NOT / NOTE:
#   - Sistem .env dosyasına BAĞIMLI DEĞİLDİR; dosya silinse bile yerleşik
#     varsayılanlarla (STDS_LANG=tr) çalışmaya devam eder.
#   - Öncelik sırası / Precedence:
#       Açık Parametre (--lang / lang=) > Ortam Değişkeni > .env > Varsayılan (tr)
#   - İngilizce çıktı için aşağıdaki STDS_LANG değerini 'en' yapabilirsiniz.
# ==============================================================================

# Çıktı, grafik, tablo, HTML pano, PDF ve CLI mesaj dili ('tr' veya 'en')
STDS_LANG=tr

# Bash boru hatlarının zaman damgalı çıktı klasörü (scripts/*.sh tarafından kullanılır)
STDS_RUNS_DIR=runs

# Varsayılan görselleştirme çözünürlüğü (DPI, >= 72)
STDS_DPI=160

# Her analiz çalıştırmasında kapsamlı PDF raporu üretilsin mi? (true / false)
STDS_PDF_EXPORT=true

# Ham CSV girişlerinde kullanılacak varsayılan cihaz profili
STDS_DEFAULT_PROFILE=visnir_24ch_v1
