# ==============================================================================
# SpaceTeknopoliDataScience (st_ds) — Example Environment Configuration
# ==============================================================================
# Copy or edit `.env` if you want to customize defaults without passing flags.
# System NEVER fails if `.env` is missing; built-in default is `STDS_LANG=tr`.
# Precedence: explicit CLI/Python arg > OS environment > .env > built-in defaults
# ==============================================================================

# Interface, chart, table, HTML dashboard, PDF report & CLI language ('tr' | 'en')
STDS_LANG=tr

# Timestamped output base folder used by scripts/*.sh
STDS_RUNS_DIR=runs

# Default matplotlib PNG/PDF rasterization DPI (>= 72)
STDS_DPI=160

# Automatically generate multi-page PDF report during visualization/workflow runs
STDS_PDF_EXPORT=true

# Default instrument profile for CSV datasets without sidecar .meta.json
STDS_DEFAULT_PROFILE=visnir_24ch_v1
